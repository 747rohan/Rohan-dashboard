# =============================================================================
# Dashboard server — environment variables template
# Copy this file to .env (server/.env) or pass via docker --env-file
# Real values must NEVER be committed to git
# =============================================================================

# --- HTTP ---
PORT=3000

# --- Basic Auth (web UI login) ---
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-me

# --- Solbot data sources (bind-mounts inside container) ---
SOLBOT_DATA_DIR=/data/solbot
SOLBOT_ORCH_DB=/data/orch/orchestrator.db
SOLBOT_PB_LOG=/data/pb.log

# --- Redis (worldmonitor stack) ---
REDIS_URL=redis://worldmonitor-redis:6379

# --- Optional: ingest endpoint key (for phase-broadcaster push) ---
PHASES_INGEST_KEY=

# --- OKX read-only API (для PnL + Trading Metrics) ---
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
OKX_EQUITY_HISTORY=/data/okx/equity_history.jsonl
OKX_CLOSED_POSITIONS=/data/okx/closed_positions.jsonl
# ISO timestamp: позиции с cTime < этой даты отфильтровываются
OKX_START_ISO=2026-05-15T00:00:00Z
